post_install() {
    # Create system user for the web backend
    if ! id -u configurator &>/dev/null; then
        useradd -r -s /sbin/nologin -d /var/lib/configurator -m configurator
    fi

    # Allow configurator user to connect to agent socket
    # Agent socket gets chmod 660, group ownership set to configurator
    # The agent service runs as root and chowns the socket after creation
    # (handled in configurator-agent.service via ExecStartPost)

    echo ""
    echo "==> confnode installed. Next steps:"
    echo "  1. Edit /etc/configurator/config.yaml"
    echo "     - Set a strong 'secret' (openssl rand -hex 32)"
    echo "     - Set 'certbot.email'"
    echo "     - Set 'apache.mode: arch' (you are on Arch Linux)"
    echo "  2. Enable and start services:"
    echo "     systemctl enable --now configurator-agent"
    echo "     systemctl enable --now configurator"
    echo "  3. Set admin password on first start via ADMIN_PASSWORD env or"
    echo "     change it in the UI afterwards"
    echo ""
}

post_upgrade() {
    echo "==> confnode upgraded. Restart services:"
    echo "    systemctl restart configurator-agent configurator"
}

pre_remove() {
    systemctl stop configurator configurator-agent 2>/dev/null || true
    systemctl disable configurator configurator-agent 2>/dev/null || true
}
