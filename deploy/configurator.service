[Unit]
Description=Configurator Web Backend
After=network.target configurator-agent.service

[Service]
Type=simple
User=configurator
Group=configurator
WorkingDirectory=/opt/configurator/backend
ExecStart=/usr/bin/node /usr/lib/configurator/backend/dist/server.js
Environment=CONFIG_PATH=/etc/configurator/config.yaml
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
